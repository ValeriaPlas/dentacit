# Copia este archivo como .env y cambia los valores antes de desplegar.

# Base de datos
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_NAME=dentacit
DB_USER=dentacit
DB_PASS=cambia-esta-clave

# Llave para firmar los tokens JWT (cadena larga y aleatoria)
JWT_SECRET=cambia-esta-llave-por-una-cadena-larga-y-aleatoria

# Llave que usan los servicios para hablar con notif-service
INTERNAL_KEY=cambia-esta-llave-interna

# URL pública del cliente web (la que abre el QR)
WEB_URL=http://localhost:8080/

# Correo (opcional). Si SMTP_HOST está vacío, los correos solo se muestran en el log de notif-service.
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DentaCit <no-reply@dentacit.local>

# Puerto público del gateway
GATEWAY_PORT=8080
