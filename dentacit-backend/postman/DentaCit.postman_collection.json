    {
      "name": "4. Citas: flujo paciente → dentista → correo",
      "item": [
        {
          "name": "Paciente solicita cita (web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/citas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pedro Ruiz\",\n  \"correo\": \"pedro.postman@correo.com\",\n  \"telefono\": \"4770001111\",\n  \"id_servicio\": 2,\n  \"fecha\": \"{{manana}}\",\n  \"hora\": \"11:00\",\n  \"sintomas\": \"Me duele una muela\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea solicitud', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Queda Pendiente (RF-04)', () => pm.expect(r.estatus).to.eql('Pendiente'));",
                  "pm.collectionVariables.set('cita_id', r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mismo paciente, segunda solicitud → 422",
