                ]
              }
            }
          ]
        },
        {
          "name": "Responder de nuevo → 422",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/citas/{{cita_id}}/estatus",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "citas",
                "{{cita_id}}",
                "estatus"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estatus\": \"Rechazada\"\n}"
            },
            "auth": {
