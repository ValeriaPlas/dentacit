{
  "info": {
    "name": "DentaCit — Pruebas de integración",
    "description": "Pruebas de integración del API Gateway de DentaCit. Ejecuta la colección completa en orden con el Collection Runner. Requiere el sistema levantado con docker compose y los datos de prueba recién cargados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "manana",
      "value": ""
    },
    {
      "key": "cita_id",
      "value": ""
    },
    {
      "key": "horario_id",
      "value": ""
    },
    {
      "key": "servicio_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(Date.now() + 86400000);",
          "pm.collectionVariables.set('manana', d.toISOString().slice(0,10));",
          "const p = new Date(Date.now() + 5*86400000);",
          "pm.collectionVariables.set('en5dias', p.toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (auth-service)",
      "item": [
        {
          "name": "Login con contraseña incorrecta → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"dentista@dentacit.com\",\n  \"password\": \"incorrecta\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales inválidas', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login correcto → token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"dentista@dentacit.com\",\n  \"password\": \"dentacit123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicia sesión', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Devuelve token JWT', () => pm.expect(r.token.split('.').length).to.eql(3));",
                  "pm.collectionVariables.set('token', r.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/verificar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verificar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token válido', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
